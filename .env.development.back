PORT=3000
# Прописываем имя контейнера где запущена база
# Контейнер бэк и БД должны быть подключены к одной сети todo-net
DB_HOST=todo-db-container
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=pass
DB_NAME=todo-pg

# Допустимый URL - который может посылать запросы на бэк
CORS_ORIGIN=http://localhost:18080
